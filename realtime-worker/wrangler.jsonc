{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jiwoos-farm-realtime",
  "main": "worker.ts",
  "compatibility_date": "2026-09-20",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN_SUFFIX": ".chatgpt.site"
  }
}
