{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "client/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "persistence/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
