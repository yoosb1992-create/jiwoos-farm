{
  "description": "Reviewable service plan for Railway dashboard/API; this is not an auto-loaded railway.json file.",
  "projectName": "jiwoos-farm-v2-6",
  "environmentName": "production",
  "repository": "yoosb1992-create/jiwoos-farm",
  "branch": "feature/v2.6-farm-content-expansion",
  "database": {
    "name": "Postgres",
    "template": "postgres",
    "privateOnly": true,
    "newDatabaseRequired": true
  },
  "services": {
    "Backend": {
      "rootDirectory": "/",
      "dockerfilePath": "multiplayer-farm/Dockerfile",
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 120,
      "sleepApplication": false,
      "waitForCi": true,
      "regions": { "asia-southeast1-eqsg3a": { "numReplicas": 1 } },
      "drainingSeconds": 30,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5,
      "watchPatterns": ["/multiplayer-farm/**"],
      "publicPort": 2567,
      "variables": {
        "RAILWAY_DOCKERFILE_PATH": "multiplayer-farm/Dockerfile",
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "2567",
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "CLIENT_ORIGINS": "https://${{Frontend.RAILWAY_PUBLIC_DOMAIN}}",
        "LAB_LATENCY_MS": "0"
      }
    },
    "Frontend": {
      "rootDirectory": "/",
      "dockerfilePath": "multiplayer-farm/Dockerfile.client",
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 120,
      "sleepApplication": false,
      "waitForCi": true,
      "regions": { "asia-southeast1-eqsg3a": { "numReplicas": 1 } },
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5,
      "watchPatterns": ["/multiplayer-farm/**", "/public/assets/**"],
      "publicPort": 8080,
      "variables": {
        "RAILWAY_DOCKERFILE_PATH": "multiplayer-farm/Dockerfile.client",
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "8080",
        "VITE_MULTIPLAYER_SERVER_URL": "wss://${{Backend.RAILWAY_PUBLIC_DOMAIN}}"
      }
    }
  }
}
