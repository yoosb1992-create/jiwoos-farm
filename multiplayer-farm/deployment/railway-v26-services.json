{
  "description": "v2.6 cutover on existing services after CI; prior branch and public DB schema remain recoverable. Dashboard/API service plan, not auto-loaded config.",
  "projectName": "jiwoos-farm-v2-5",
  "environmentName": "production",
  "repository": "yoosb1992-create/jiwoos-farm",
  "branch": "feature/v2.6-farm-content-expansion",
  "database": {
    "name": "Postgres",
    "existing": true,
    "schema": "farm_v26",
    "preservedSchema": "public",
    "privateOnly": true,
    "automaticSchemaMigration": true
  },
  "services": {
    "Backend": {
      "rootDirectory": "/",
      "dockerfilePath": "multiplayer-farm/Dockerfile",
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 120,
      "sleepApplication": false,
      "waitForCi": true,
      "regions": {
        "asia-southeast1-eqsg3a": {
          "numReplicas": 1
        }
      },
      "drainingSeconds": 30,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5,
      "watchPatterns": [
        "/multiplayer-farm/server/**",
        "/multiplayer-farm/shared/**",
        "/multiplayer-farm/persistence/**",
        "/multiplayer-farm/package*.json",
        "/multiplayer-farm/tsconfig*.json",
        "/multiplayer-farm/Dockerfile"
      ],
      "publicPort": 2567,
      "variables": {
        "RAILWAY_DOCKERFILE_PATH": "multiplayer-farm/Dockerfile",
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "2567",
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "CLIENT_ORIGINS": "https://${{Frontend.RAILWAY_PUBLIC_DOMAIN}}",
        "LAB_LATENCY_MS": "0"
      }
    },
    "Frontend": {
      "rootDirectory": "/",
      "dockerfilePath": "multiplayer-farm/Dockerfile.client",
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 120,
      "sleepApplication": false,
      "waitForCi": true,
      "regions": {
        "asia-southeast1-eqsg3a": {
          "numReplicas": 1
        }
      },
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 5,
      "watchPatterns": [
        "/multiplayer-farm/client/**",
        "/multiplayer-farm/shared/**",
        "/multiplayer-farm/build/**",
        "/multiplayer-farm/package*.json",
        "/multiplayer-farm/tsconfig*.json",
        "/multiplayer-farm/vite.config.ts",
        "/multiplayer-farm/index.html",
        "/multiplayer-farm/deployment/static-server.mjs",
        "/multiplayer-farm/Dockerfile.client",
        "/public/assets/**"
      ],
      "publicPort": 8080,
      "variables": {
        "RAILWAY_DOCKERFILE_PATH": "multiplayer-farm/Dockerfile.client",
        "NODE_ENV": "production",
        "HOST": "0.0.0.0",
        "PORT": "8080",
        "VITE_MULTIPLAYER_SERVER_URL": "wss://${{Backend.RAILWAY_PUBLIC_DOMAIN}}"
      }
    }
  },
  "rollback": {
    "branch": "feature/v2.5-multiplayer-farm-rebuild",
    "sha": "3fad61ce6c567fe5449371e8ecf871282b6b69df",
    "databaseSchema": "public",
    "sessionKey": "farm-v25-session"
  }
}
