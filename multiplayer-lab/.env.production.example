# Build-time client value. Replace with the separately deployed Lab server.
VITE_MULTIPLAYER_SERVER_URL=wss://lab-server.example.com
# Runtime server values. TLS is terminated at the reverse proxy.
NODE_ENV=production
HOST=0.0.0.0
PORT=2567
CLIENT_ORIGINS=https://lab-client.example.com
LAB_LATENCY_MS=0
