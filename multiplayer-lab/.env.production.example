# Reference only: these example hosts are NOT deployed public URLs.
# For phone-only Railway setup use RAILWAY.md and its per-service Raw Editor blocks.
# Do not paste both services' variables into one Railway service.

# BACKEND runtime service (Dockerfile).
NODE_ENV=production
HOST=0.0.0.0
PORT=2567
CLIENT_ORIGINS=https://REPLACE-WITH-FRONTEND.example.com
LAB_LATENCY_MS=0

# FRONTEND build service (Dockerfile.client): replace with the real public Backend.
# Dockerfile.client declares ARG VITE_MULTIPLAYER_SERVER_URL for the Vite build.
VITE_MULTIPLAYER_SERVER_URL=wss://REPLACE-WITH-BACKEND.example.com
# FRONTEND runtime uses NODE_ENV=production, HOST=0.0.0.0 and PORT=8080.
# The VITE variable is baked into JavaScript; changing it requires a new build.

# Railway values are entered per service, not loaded from this file:
# Backend: RAILWAY_DOCKERFILE_PATH=Dockerfile
# Backend: CLIENT_ORIGINS=https://${{Frontend.RAILWAY_PUBLIC_DOMAIN}}
# Frontend: RAILWAY_DOCKERFILE_PATH=Dockerfile.client
# Frontend: VITE_MULTIPLAYER_SERVER_URL=wss://${{Backend.RAILWAY_PUBLIC_DOMAIN}}
# Both: RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
