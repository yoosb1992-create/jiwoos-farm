# Copy to .env for development. For a phone, replace 127.0.0.1 below
# with your PC's LAN IPv4 address, e.g. 192.168.0.20.
VITE_MULTIPLAYER_SERVER_URL=ws://127.0.0.1:2567
HOST=0.0.0.0
PORT=2567
# Comma-separated browser origins. Empty permits origins in development only.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development ONLY; added round-trip latency in milliseconds.
LAB_LATENCY_MS=0
